// 로스트아크 길드 레이드 편성표
//
// 핵심 구조: 슬롯 정의(RaidSlot)와 인원 배정(Assignment)을 분리한다.
// 슬롯은 고정 요일표라 영속적이고, 배정은 weekStart를 가져 매주 리셋된다.
// 리셋은 삭제가 아니라 "현재 주차 배정만 조회"하는 방식이라 과거 기록이 남는다.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // 생성된 파일끼리 확장자 없이 import하면 node가 해석하지 못한다.
  // prisma/seed.mts처럼 node로 직접 돌리는 스크립트를 위해 확장자를 붙인다.
  importFileExtension = "ts"
}

// Prisma 7부터 접속 URL은 스키마가 아니라 prisma.config.ts에서 읽는다.
// 런타임 접속은 PrismaClient에 넘기는 드라이버 어댑터가 담당한다(src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
}

/// 길드 하나 = 인스턴스 하나. 1단계는 기본 인스턴스 1개만 쓴다.
model Instance {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  /// 쓰지 않는다. 입장은 디스코드 길드 멤버십으로 가린다(CLAUDE.md 4장).
  /// 대체가 실제로 끝나기 전까지 컬럼만 남겨둔다.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members    Member[]
  rosters    Roster[]
  characters Character[]
  slots      RaidSlot[]
  changeLogs ChangeLog[]
}

/// 사람별 화면 설정.
///
/// 인스턴스와 무관하다. 같은 사람이 여러 길드 편성표를 봐도 테마는 하나다.
/// 쿠키가 있는데도 여기에 두는 이유는 **기기가 바뀌어도 따라오게** 하려는 것이다.
/// 쿠키는 브라우저 안에서만 살아 PC와 폰이 따로 논다.
model UserSetting {
  /// 디스코드 사용자 ID. 세션이 들고 있는 값이라 조회에 추가 비용이 없다.
  discordUserId String   @id
  /// "light" | "dark". 없으면 시스템 설정을 따른다.
  theme         String?
  /// "compact" | "full". 편성표 보기 방식.
  boardView     String?
  updatedAt     DateTime @updatedAt
}

/// 한 사람. 부캐 여럿이 동일인임을 표현해 중복 참여 경고에 쓴다.
model Member {
  id            String   @id @default(cuid())
  instanceId    String
  /// 사람을 가리키는 이름. 디스코드 길드 닉네임을 기본값으로 채운다.
  label         String
  /// 원정대를 클레임한 디스코드 계정. 클레임 전에는 비어 있다.
  discordUserId String?
  /// 클레임한 원정대의 캐릭터 이름.
  ///
  /// 나중에 등록되는 캐릭터도 이 목록에 있으면 자동으로 이 사람에게 붙는다.
  /// 편성 칸에 남이 대신 넣어줘도 소속이 잡히는 이유가 이것이다.
  /// 계정이 여럿인 사람은 클레임을 여러 번 해서 이름이 계속 쌓인다.
  claimedNames  String[] @default([])
  createdAt     DateTime @default(now())

  instance   Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  characters Character[]
  rosters    Roster[]

  @@unique([instanceId, label])
  // 유니크가 아니라 인덱스다. 이미 있는 표에 유니크를 얹으려면 데이터 손실을 감수하는
  // 플래그가 필요한데, 클레임은 사람당 한 번 있는 일이라 코드에서 막는 편이 싸다.
  @@index([instanceId, discordUserId])
  @@index([instanceId])
}

/// 원정대 하나. 로아 계정 하나에 해당한다.
///
/// **골드 획득 제한이 원정대 단위라서 필요하다.** 한 원정대에서 주간 레이드 골드를
/// 받는 캐릭터는 6명뿐이고, 그 6명이 누구인지는 사람이 아니라 원정대마다 갈린다.
/// Member로는 셀 수 없다. 계정이 여럿인 사람은 한 Member 아래 원정대가 여럿이다.
///
/// **"내 원정대 불러오기" 한 번이 원정대 하나다.** 로아 `siblings`가 한 계정의 원정대만
/// 주고 부계정을 이어 줄 방법이 API에 없어서, 사람이 계정마다 한 번씩 부르는 것이
/// 곧 경계가 된다. 그때 친 대표 캐릭터명을 이름으로 삼는다.
model Roster {
  id         String   @id @default(cuid())
  instanceId String
  memberId   String
  /// 불러올 때 친 대표 캐릭터명. 캐릭터 관리의 탭 이름으로 그대로 쓴다.
  label      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance   Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  characters Character[]

  @@unique([instanceId, label])
  @@index([memberId])
}

model Character {
  id         String  @id @default(cuid())
  instanceId String
  memberId   String?
  /// 어느 원정대의 캐릭터인가. 골드 6명 제한을 세는 단위다.
  ///
  /// 편성 칸에 남이 대신 쳐 넣어 만들어진 캐릭터는 비어 있다. 주인이 한 번
  /// 불러오면 붙는다(members.ts의 claimNames).
  rosterId   String?
  /// 로스트아크 캐릭터 닉네임. API 조회 키다.
  name       String

  // --- 로아 OpenAPI에서 받아오는 값 ---
  className      String?
  /// 칭호. "죽음을 부르는 자". 스펙은 아니지만 카드에서 이름 위에 얹는다.
  title          String?
  itemLevel      Decimal? @db.Decimal(7, 2)
  combatPower    Decimal? @db.Decimal(10, 2)
  serverName     String?
  /// CharacterImage. 편성 칸 배경으로 쓴다. null일 수 있다.
  imageUrl       String?
  /// 직업 각인. "수라의 길 Lv.1". 아크패시브 깨달음 1티어에서 뽑는다.
  /// 칸에 클래스와 나란히 보여줄 값이라 따로 꺼내 둔다.
  classEngraving String?
  /// 아크패시브 전체(진화·깨달음·도약 노드와 포인트). 툴팁은 제외한다.
  arkPassive     Json?
  /// 전투 각인(원한, 예리한 둔기 …). 직업 각인이 아니다.
  engravings     Json?
  /// 아크그리드 코어와 효과. 툴팁은 제외한다.
  arkGrid        Json?
  /// 스킬 트라이포드에서 읽은 파티 시너지. 툴팁은 제외한다.
  ///
  /// null과 빈 배열이 다른 뜻이다. null은 스킬을 받아본 적이 없다는 뜻이라 클래스 표로
  /// 떨어지고, 빈 배열은 받아봤는데 시너지 트라이포드를 안 찍었다는 뜻이라 경고를 띄운다.
  skillSynergies Json?

  /// 클래스로 자동 판정하되 수동 override를 허용한다(딜 발키리 등).
  role       Role    @default(DPS)
  roleLocked Boolean @default(false)

  /// 주간 레이드 골드를 받는 캐릭터인가.
  ///
  /// **null이면 자동이다.** 원정대에서 템레벨 상위 6명을 골드 획득으로 본다. 캐릭터를
  /// 새로 등록할 때마다 사람이 손대지 않아도 맞는 답이 나오는 쪽이 기본이어야 한다.
  ///
  /// 사람이 한 번 지정하면 그 원정대의 캐릭터 전체에 true/false가 박힌다. 일부만
  /// 박아 두면 "자동인데 왜 이 캐릭터가 빠지지"를 설명할 길이 없다(goldEarners.ts).
  goldEarner Boolean?

  syncedAt  DateTime?
  /// 조회 실패 사유. 값이 있어도 기존 스펙은 지우지 않는다.
  syncError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  member      Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  roster      Roster?      @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  assignments Assignment[]

  @@unique([instanceId, name])
  @@index([instanceId])
  @@index([memberId])
  @@index([rosterId])
}

/// 고정 요일표의 한 칸. 주차 개념이 없다.
model RaidSlot {
  id          String    @id @default(cuid())
  instanceId  String
  /// 0=일 … 6=토
  dayOfWeek   Int
  /// "20:00" 형식의 KST 시각
  startTime   String
  raidName    String
  difficulty  String?
  /// 8인이면 4인 파티 둘, 4인이면 하나. 프리셋이 채우고 손으로 바꿀 수 있다.
  partySize   Int       @default(8)
  /// 켜면 이 슬롯 전원이 매주 승계된다(레이드 단위 리셋 제외).
  keepRoster  Boolean   @default(false)
  sortOrder   Int       @default(0)
  /// 삭제 대신 보관. 과거 주차 기록이 사라지지 않게 한다.
  archivedAt  DateTime?
  /// 승계를 이미 수행한 주차. 이 값이 조회 중인 주차와 다를 때만 직전 주차에서 복사한다.
  /// 없으면 "고정 인원을 지웠는데 새로고침하면 되살아나는" 상황이 생긴다.
  carriedWeek DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([instanceId, dayOfWeek])
}

model Assignment {
  id             String   @id @default(cuid())
  slotId         String
  /// 주차 시작 시각(UTC 저장). 수요일 06:00 KST 기준이며, 화요일 슬롯과 나머지 요일이
  /// 서로 다른 주차를 가리키는 구간이 있다(src/lib/week.ts).
  weekStart      DateTime
  /// DPS1..DPS3 + SUP1 (1파티), DPS4..DPS6 + SUP2 (2파티)
  position       String
  characterId    String
  /// 켜면 이 자리만 매주 승계된다(자리 단위 리셋 제외).
  pinned         Boolean  @default(false)
  /// 숙제 화면에서 이 캐릭터가 정해 둔 레이드 순서.
  ///
  /// **앞의 셋만 골드를 받는다**(goldEarners.ts의 RAID_GOLD_LIMIT). 그래서 순서가
  /// 곧 "어느 레이드에서 골드를 받을 것인가"다. 게임에서 사람이 고르는 값이라
  /// 앱이 대신 정할 수 없다.
  ///
  /// null이면 아직 정하지 않았다는 뜻이라 보상이 큰 순으로 세운다. 사람이 한 번
  /// 끌어 옮기면 그 캐릭터의 그 주 배정 전체에 0부터 번호가 박힌다. 그 뒤에 새로
  /// 들어온 배정만 null로 남아 맨 뒤에 붙는다. 나중에 온 레이드가 골드 자리를
  /// 조용히 뺏지 않게 하려는 것이다.
  ///
  /// 승계할 때는 복사하지 않는다(board.ts). 주차가 바뀌면 다시 보상 순이다.
  homeworkOrder  Int?
  note           String?
  /// 넣은 사람의 디스코드 길드 닉네임. 폼이 아니라 세션에서 읽는다(CLAUDE.md 4장).
  createdByLabel String?
  createdAt      DateTime @default(now())

  slot      RaidSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([slotId, weekStart, position])
  @@index([weekStart])
  @@index([characterId])
}

/// 입장한 사람은 누구의 신청이든 지울 수 있다(하드 블로킹을 두지 않는다).
/// 그래서 누가 했는지를 남긴다. 디스코드 로그인 뒤로는 actorLabel이 검증된 값이다.
model ChangeLog {
  id         String    @id @default(cuid())
  instanceId String
  weekStart  DateTime?
  slotId     String?
  actorLabel String?
  action     String
  detail     Json?
  createdAt  DateTime  @default(now())

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
}

enum Role {
  DPS
  SUPPORT
}
