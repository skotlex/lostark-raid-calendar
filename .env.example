# 이 파일을 .env.local로 복사한 뒤 값을 채운다.
# .env.local은 .gitignore에 걸려 있다. 실제 값을 이 파일에 적지 않는다.

# --- Postgres (Neon) ---
# Neon은 접속 문자열이 두 개다. 둘 다 콘솔의 Connect 화면에서 복사할 수 있다.
#
#  1) 풀링(pooled): 호스트에 "-pooler"가 붙어 있다. 앱 런타임이 쓴다.
#     서버리스는 짧은 커넥션을 많이 만들기 때문에 풀러를 거쳐야 한다.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=verify-full"
#
#  2) 직결(unpooled): "-pooler"가 없다. prisma db push / migrate가 쓴다.
#     스키마 변경은 풀러를 통과할 수 없어 직결이 필요하다.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=verify-full"

# --- 로스트아크 공식 OpenAPI ---
# https://developer-lostark.game.onstove.com 에서 클라이언트를 만들면 즉시 발급된다.
# 서버에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 새어 나가므로 절대 금지.
LOSTARK_API_KEY="YOUR_LOSTARK_JWT_HERE"

# --- 입장 세션 쿠키 서명 키 ---
# 아무 긴 랜덤 문자열이면 된다: node -e "console.log(crypto.randomUUID())"
INSTANCE_SESSION_SECRET="YOUR_RANDOM_SECRET_HERE"

# --- 디스코드 로그인 (2단계 기능, CLAUDE.md 4장) ---
# https://discord.com/developers/applications 에서 앱을 만들고 OAuth2 탭에서 받는다.
# 클라이언트 ID는 공개돼도 되지만 시크릿은 LOSTARK_API_KEY와 같은 등급이다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다.
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# 입장을 허용할 길드(서버) ID. 디스코드에서 개발자 모드를 켜고 서버 우클릭 → ID 복사.
DISCORD_GUILD_ID="YOUR_DISCORD_GUILD_ID"
