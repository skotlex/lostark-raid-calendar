# 이 파일을 .env.local로 복사한 뒤 값을 채운다.
# .env.local은 .gitignore에 걸려 있다. 실제 값을 이 파일에 적지 않는다.

# --- Postgres (Supabase) ---
# 접속 문자열이 두 개다. 둘 다 대시보드의 Connect 화면에서 복사할 수 있다.
# 지역은 서울(ap-northeast-2)이다. Vercel도 icn1이라 둘이 같은 지역에 있다.
#
#  1) 풀링(Transaction pooler): 포트 6543. 앱 런타임이 쓴다.
#     서버리스는 짧은 커넥션을 많이 만들기 때문에 풀러(Supavisor)를 거쳐야 한다.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
#
#  2) 직결(Direct connection): 포트 5432. prisma db push / migrate가 쓴다.
#     스키마 변경은 풀러를 통과할 수 없어 직결이 필요하다.
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- 로스트아크 공식 OpenAPI ---
# https://developer-lostark.game.onstove.com 에서 클라이언트를 만들면 즉시 발급된다.
# 서버에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 새어 나가므로 절대 금지.
LOSTARK_API_KEY="YOUR_LOSTARK_JWT_HERE"

# 한도는 키마다 따로 센다(분당 100회). 클라이언트를 여러 개 만들어 쉼표로 나열하면
# 그만큼 늘어나고, 요청도 키 수만큼 동시에 나간다. 있으면 이쪽을 먼저 읽는다.
# LOSTARK_API_KEYS="JWT_1,JWT_2,JWT_3"

# --- 입장 세션 쿠키 서명 키 ---
# 아무 긴 랜덤 문자열이면 된다: node -e "console.log(crypto.randomUUID())"
INSTANCE_SESSION_SECRET="YOUR_RANDOM_SECRET_HERE"

# --- 디스코드 로그인 (2단계 기능, CLAUDE.md 4장) ---
# https://discord.com/developers/applications 에서 앱을 만들고 OAuth2 탭에서 받는다.
# 클라이언트 ID는 공개돼도 되지만 시크릿은 LOSTARK_API_KEY와 같은 등급이다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다.
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# 입장을 허용할 길드(서버) ID. 디스코드에서 개발자 모드를 켜고 서버 우클릭 → ID 복사.
DISCORD_GUILD_ID="YOUR_DISCORD_GUILD_ID"

# 길드 멤버십 재검사용 봇 토큰. 같은 앱의 Bot 탭에서 Reset Token으로 받는다.
# 세션 쿠키는 30일짜리라 이게 없으면 길드를 나간 사람이 한 달 내내 들어온다.
#
# 봇을 길드에 초대해야 동작한다(권한은 필요 없다. 초대만 되면 된다).
# 단건 멤버 조회는 특권 인텐트가 필요 없으므로 포털에서 켤 것도 없다.
# 없으면 재검사를 조용히 건너뛴다 — 로컬 개발은 이 값 없이도 돈다.
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# --- Vercel 크론 (api/keep-alive) ---
# Supabase 무료 프로젝트는 7일간 활동이 없으면 정지되고, 사람이 대시보드에서 직접
# 되살려야 한다. 하루 한 번 DB를 찌르는 크론이 그것을 막는다.
#
# Vercel에만 넣으면 된다(로컬에는 필요 없다). 값이 있으면 크론 요청의 Bearer를
# 검사하고, 없으면 검사하지 않는다.
# CRON_SECRET="YOUR_RANDOM_SECRET_HERE"
